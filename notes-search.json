---
layout: null
permalink: /notes-search.json
---
{% assign allnotes = site.notes | where_exp: "note", "note.path != '_notes/Home.md'" %}
[
{% for note in allnotes %}
  {
    "title": {{ note.title | jsonify }},
    "url": {{ note.url | relative_url | jsonify }},
    "date": {{ note.date | date: "%Y-%m-%d" | jsonify }},
    "tags": {{ note.tags | jsonify }},
    "excerpt": {{ note.excerpt | strip_html | strip_newlines | normalize_whitespace | jsonify }},
    "content": {{ note.content | strip_html | strip_newlines | normalize_whitespace | truncatewords: 600 | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]